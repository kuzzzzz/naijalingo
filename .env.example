# Copy to .env.local and fill in values. Never commit real secrets.

# --- Translation providers ---
# Preferred: ordered fallback list (first success wins)
# Examples:
#   TRANSLATION_PROVIDERS=xai,anthropic,openai,mock
#   TRANSLATION_PROVIDERS=anthropic,openai
#   TRANSLATION_PROVIDERS=mock
TRANSLATION_PROVIDERS=mock

# Or a single provider (used only if TRANSLATION_PROVIDERS is unset)
# TRANSLATION_PROVIDER=mock

# --- xAI / Grok ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI (or compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: future database
# DATABASE_URL=postgresql://user:pass@localhost:5432/naijalingo
