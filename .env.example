# Copy to .env.local (or set in Vercel Environment Variables). Never commit real secrets.

# --- Translation providers ---
# Ordered fallback list (first success wins)
# Free, no card:
#   TRANSLATION_PROVIDERS=huggingface
# Google (needs working Gemini project / billing in some regions):
#   TRANSLATION_PROVIDERS=google
# Full stack:
#   TRANSLATION_PROVIDERS=google,huggingface,xai,anthropic,openai,mock
TRANSLATION_PROVIDERS=huggingface

# --- Hugging Face (recommended free option; no credit card) ---
# Create token: https://huggingface.co/settings/tokens
HF_TOKEN=
# HUGGINGFACE_API_KEY=   # alias also accepted
HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# HF_BASE_URL=https://router.huggingface.co/v1

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- xAI / Grok ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenAI (or compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
