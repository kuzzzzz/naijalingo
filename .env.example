# Copy to .env.local (or set in Vercel Environment Variables). Never commit real secrets.

# --- Translation providers ---
# Ordered fallback list (first success wins)
# Recommended free-first setup:
#   TRANSLATION_PROVIDERS=google,mock
# Full stack:
#   TRANSLATION_PROVIDERS=google,xai,anthropic,openai,mock
TRANSLATION_PROVIDERS=google,mock

# Or a single provider (used only if TRANSLATION_PROVIDERS is unset)
# TRANSLATION_PROVIDER=google

# --- Google Gemini (free tier available) ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias also accepted
GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- xAI / Grok ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenAI (or compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: future database
# DATABASE_URL=postgresql://user:pass@localhost:5432/naijalingo
